{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/frontend/$1" },
    { "src": "/api/(.*)", "dest": "https://alamdieng-waste-prediction-api.hf.space/api/$1" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
