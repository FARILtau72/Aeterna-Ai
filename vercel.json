{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/static/$1" },
    { "source": "/api/(.*)", "destination": "https://alamdieng-waste-prediction-api.hf.space/api/$1" },
    { "source": "/(.*)", "destination": "/static/$1" }
  ]
}
